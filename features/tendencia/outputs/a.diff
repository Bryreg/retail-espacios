+# ─── SQLite: convivencia de escritores (dev/test) ─────────────────────────────
+#
+# En SQLite hay varios escritores a la vez contra el MISMO archivo: el ciclo de
+# mantenimiento en su hilo (vencer contratos, purgar bitácora, cerrar el mes de
+# la serie de tendencia) corre en paralelo con las peticiones, y —como el
+# registro y la base "de siempre" comparten archivo— vencen sobre el mismo
+# fichero. Sin un `busy_timeout`, un segundo escritor no espera: falla en el acto
+# con "database is locked" / "readonly database". El PRAGMA hace que espere su
+# turno (30 s) en vez de fallar. En Postgres (producción) este camino ni se toca
+# —el `connect_args` de SQLite ya no aplica— y el MVCC del motor resuelve lo
+# mismo sin ayuda. Se registra a nivel de la CLASE `Engine` para cubrir de una
+# todos los motores del proceso: el registro y el de cada cliente, creados en
+# `app/clientes.py`.
+#
+# NO se activa WAL a propósito: dejaría ficheros `-wal`/`-shm` que el arnés de
+# pruebas (que borra `retail_espacios.db`/`recabra_*.db` entre pruebas, no sus
+# laterales) no limpia, y como las bases de cliente reusan el nombre por slug
+# entre pruebas, un `-wal` viejo contaminaría la prueba siguiente. El
+# `busy_timeout` alcanza para la contención real sin ese riesgo.
+if SQLALCHEMY_DATABASE_URL.startswith("sqlite"):
+
+    @event.listens_for(Engine, "connect")
+    def _sqlite_pragmas(dbapi_conn, _record):  # noqa: ANN001
+        cur = dbapi_conn.cursor()
+        try:
+            cur.execute("PRAGMA busy_timeout=30000")  # 30 s: esperar, no fallar
+        finally:
+            cur.close()
+
+
 class Base(DeclarativeBase):
     pass
 
