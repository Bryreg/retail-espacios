+// ─── Tendencia temporal (Fase 5 plataforma) ─────────────────────────────────
+//
+// La serie histórica de los mismos agregados públicos, mes a mes. El backend la
+// arma leyendo `snapshot_metricas` (tabla nueva del registro) y aplicando la
+// supresión K=3 y el saneo AL LEER, reusando la lógica de `plataforma_metricas`
+// -- así el histórico nunca queda congelado con una privacidad vieja. Nunca trae
+// filas de negocio ni datos de usuarios finales, igual que `/metricas`.
+
+/** El slug reservado para pedir el consolidado ponderado en vez de un cliente. */
+export const TENDENCIA_CONSOLIDADO = "__consolidado__";
+
+/** Agregados públicos de UN mes de la serie. Es el mismo juego de `/metricas`
+ *  sin `ultimo_acceso` (que no tiene sentido histórico). Los montos y la
+ *  ocupación pueden venir `null`: por K=3 (celda chica suprimida ese mes) o por
+ *  no haber denominador -- el frontend los trata como huecos, nunca como 0. */
+export interface AgregadosMes {
+  sedes_con_plano: number;
+  espacios_comercializables: number;
+  ocupacion_pct: number | null;
+  canon_promedio_mensual: number | null;
+  ingreso_contratado_mes: number | null;
+  top_proveedores: ProveedorTop[];
+  usuarios_con_cuenta: number;
+}
+
+export interface PuntoTendencia {
+  /** "YYYY-MM". */
+  periodo: string;
+  /** El mes en curso, que todavía está convergiendo -- se marca como parcial. */
+  parcial: boolean;
+  metricas: AgregadosMes;
+}
+
+export interface Tendencia {
+  /** El slug consultado, o `__consolidado__`. */
+  cliente: string;
+  meses_pedidos: number;
+  generado_en: string;
+  /** `false` con < 2 meses de historia: no hay tendencia que mostrar todavía. */
+  suficiente: boolean;
+  /** Cronológica (del más viejo al más nuevo), sólo los meses con dato. */
+  serie: PuntoTendencia[];
+}
+
+/** `cliente` = un slug o `__consolidado__` (default). `meses` se acota a 1..24
+ *  en el backend. Cada llamada queda anotada en la bitácora del registro. */
+export const getTendencia = (cliente: string, meses?: number): Promise<Tendencia> =>
+  client
+    .get<Tendencia>("/plataforma/tendencia", {
+      params: { cliente, ...(meses ? { meses } : {}) },
+    })
+    .then((r) => r.data);
diff --git a/frontend/src/components/plataforma/consola.tsx b/frontend/src/components/plataforma/consola.tsx
index 94a7e83..d54e577 100644
--- a/frontend/src/components/plataforma/consola.tsx
+++ b/frontend/src/components/plataforma/consola.tsx
@@ -427,3 +427,125 @@ export function TablaHead({ children }: { children: ReactNode }) {
 export function Fila({ children }: { children: ReactNode }) {
   return <div className="con-fila" style={filaBase}>{children}</div>;
 }
+
+// ═══ Gráfico de LÍNEA con eje desde cero (tendencia = cambio en el tiempo) ═══
+//
+// SVG propio, sin librería de charts (bajo la CSP de Fase 3, que no admite un
+// script externo). Se pinta con los tokens `--con-*`, de modo que cambia de tema
+// con el atributo de la raíz, igual que las barras. Reglas que fija:
+//  · Eje desde CERO siempre: una tendencia se lee por la pendiente, y un eje
+//    recortado la exagera o la aplana. El track 0→máx queda explícito.
+//  · Un `valor` null es un HUECO, no un cero: la línea se corta y el punto no se
+//    dibuja (K=3 o sin denominador ese mes).
+//  · El mes en curso (`parcial`) se marca distinto —anillo hueco + segmento
+//    entrante punteado— porque su número todavía está convergiendo.
+//  · Cada punto es enfocable e inspeccionable (título nativo con el detalle).
+
+export interface PuntoLinea {
+  /** Clave estable del punto ("YYYY-MM"). */
+  periodo: string;
+  /** Etiqueta corta bajo el eje X (p. ej. "sep"). */
+  etiqueta: string;
+  /** El valor del mes, o `null` si ese mes no tiene dato (hueco, no 0). */
+  valor: number | null;
+  /** El mes en curso, que todavía converge. */
+  parcial: boolean;
+  /** Texto del tooltip nativo del punto (lo arma quien llama, ya formateado). */
+  tooltip: string;
+}
+
+const LINEA_W = 620;
+const LINEA_H = 150;
+const LINEA_PAD = { top: 12, right: 14, bottom: 26, left: 44 };
+
+/** Gráfico de línea de una serie temporal. `max` es el tope del eje (desde 0);
+ *  `etiquetaMax`/`etiquetaCero` son las marcas del eje Y ya formateadas. */
+export function LineaTendencia({
+  puntos, max, etiquetaMax, etiquetaCero = "0", color = "var(--con-mag-fill)", titulo,
+}: {
+  puntos: PuntoLinea[];
+  max: number;
+  etiquetaMax: string;
+  etiquetaCero?: string;
+  color?: string;
+  /** Descripción accesible del gráfico entero (`aria-label` del SVG). */
+  titulo: string;
+}) {
+  const innerW = LINEA_W - LINEA_PAD.left - LINEA_PAD.right;
+  const innerH = LINEA_H - LINEA_PAD.top - LINEA_PAD.bottom;
+  const tope = max > 0 ? max : 1;
+
+  const x = (i: number) =>
+    LINEA_PAD.left + (puntos.length <= 1 ? innerW / 2 : (innerW * i) / (puntos.length - 1));
+  const y = (v: number) => LINEA_PAD.top + innerH - (Math.max(0, Math.min(tope, v)) / tope) * innerH;
+
+  // Coordenadas de los puntos con dato; los null se saltan (hueco).
+  const pts = puntos.map((p, i) => ({ ...p, i, cx: x(i), cy: p.valor === null ? null : y(p.valor) }));
+
+  // Segmentos entre puntos con dato CONSECUTIVOS (un null corta la línea). Un
+  // segmento que entra al mes parcial va punteado.
+  const segmentos: { x1: number; y1: number; x2: number; y2: number; punteado: boolean }[] = [];
+  for (let i = 1; i < pts.length; i++) {
+    const a = pts[i - 1];
+    const b = pts[i];
+    if (a.cy === null || b.cy === null) continue;
+    segmentos.push({ x1: a.cx, y1: a.cy, x2: b.cx, y2: b.cy, punteado: b.parcial });
+  }
+
+  const yCero = y(0);
+  const yMax = y(tope);
+  // Con muchos meses, no se etiqueta cada uno: se saltea para no amontonar.
+  const paso = puntos.length > 14 ? 3 : puntos.length > 8 ? 2 : 1;
+
+  return (
+    <svg
+      viewBox={`0 0 ${LINEA_W} ${LINEA_H}`}
+      width="100%"
+      role="img"
+      aria-label={titulo}
+      style={{ display: "block", height: "auto", overflow: "visible" }}
+    >
+      {/* Rejilla: eje cero (abajo) y tope (arriba), con sus marcas a la izquierda. */}
+      <line x1={LINEA_PAD.left} y1={yCero} x2={LINEA_W - LINEA_PAD.right} y2={yCero} stroke="var(--con-line)" strokeWidth={1} />
+      <line x1={LINEA_PAD.left} y1={yMax} x2={LINEA_W - LINEA_PAD.right} y2={yMax} stroke="var(--con-line-soft)" strokeWidth={1} strokeDasharray="2 3" />
+      <text x={LINEA_PAD.left - 6} y={yCero} textAnchor="end" dominantBaseline="middle" fontSize={9.5} fill="var(--con-ink-4)" fontFamily="var(--font-mono)">{etiquetaCero}</text>
+      <text x={LINEA_PAD.left - 6} y={yMax} textAnchor="end" dominantBaseline="middle" fontSize={9.5} fill="var(--con-ink-4)" fontFamily="var(--font-mono)">{etiquetaMax}</text>
+
+      {/* La línea, segmento a segmento (para poder puntear el tramo parcial). */}
+      {segmentos.map((s, k) => (
+        <line
+          key={k}
+          x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2}
+          stroke={color} strokeWidth={2}
+          strokeLinecap="round"
+          strokeDasharray={s.punteado ? "4 3" : undefined}
+        />
+      ))}
+
+      {/* Puntos + etiqueta del mes. El parcial va hueco (anillo). */}
+      {pts.map((p) => (
+        <g key={p.periodo}>
+          {p.cy !== null && (
+            <circle
+              cx={p.cx} cy={p.cy} r={3.5}
+              fill={p.parcial ? "var(--con-surface)" : color}
+              stroke={color} strokeWidth={p.parcial ? 2 : 1}
+              tabIndex={0}
+              className="con-focusable"
+            >
+              <title>{p.tooltip}</title>
+            </circle>
+          )}
+          {p.i % paso === 0 && (
+            <text
+              x={p.cx} y={LINEA_H - 8} textAnchor="middle"
+              fontSize={9.5} fill="var(--con-ink-4)" fontFamily="var(--font-mono)"
+            >
+              {p.etiqueta}{p.parcial ? "*" : ""}
+            </text>
+          )}
+        </g>
+      ))}
+    </svg>
+  );
+}
