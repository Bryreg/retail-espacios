index 0000000..de1aacb
--- /dev/null
+++ b/backend/app/plataforma_tendencia.py
@@ -0,0 +1,296 @@
+"""Serie de tiempo de las métricas del negocio (Fase 5).
+
+El endpoint de métricas (Fase 4) es una foto del mes elegido: no guarda historia,
+así que no puede contestar «¿estamos mejorando o empeorando?». Este módulo
+persiste un snapshot mensual de los agregados CRUDOS por cliente
+(``snapshot_metricas``, tabla nueva del registro) y expone la serie de los
+últimos N meses con los agregados PÚBLICOS por mes, lista para graficar.
+
+**No duplica una sola fórmula de ``plataforma_metricas``.** El snapshot guarda
+los mismos ``crudos`` que ``_metricas_de_un_cliente`` ya calcula, y al leer la
+serie se reusan ``publicas_desde_crudos`` (por cliente, con K=3) y
+``consolidar_agregado`` (consolidado ponderado, con K=3). La supresión de celda
+chica y el saneo del nombre del proveedor viven en un solo lugar, y el histórico
+nunca queda «congelado» con una supresión vieja: se aplica AL LEER.
+
+**Cómo se llena** (híbrido, sin job nuevo):
+
+* **Write-through** — ``plataforma_metricas.calcular`` llama a
+  ``persistir_snapshots`` en cada cálculo real. El mes en curso converge (se
+  actualiza en cada vista); un mes ya pasado se congela la primera vez que
+  alguien lo mira.
+* **Cierre en mantenimiento** — ``cerrar_mes_anterior`` corre desde
+  ``main.py::_run_lease_maintenance`` (cada 12 h) y captura el MES YA CERRADO si
+  aún le falta a algún cliente, para que la serie no dependa de que alguien haya
+  abierto la consola ese mes.
+
+Ambos caminos son idempotentes (``UNIQUE(cliente_slug, periodo)``, upsert) y
+read-only sobre las bases de cliente: el snapshot sólo escribe en el registro.
+"""
+import json
+import logging
+from datetime import datetime, timezone
+
+from app.plataforma_metricas import (
+    consolidar_agregado,
+    normalizar_periodo,
+    periodo_actual,
+    publicas_desde_crudos,
+    rango_del_periodo,
+)
+
+log = logging.getLogger("recabra.plataforma.tendencia")
+
+MESES_DEFAULT = 12
+MESES_MAXIMO = 24
+
+
+# ─── El período, un mes a la vez ──────────────────────────────────────────────
+
+def mes_anterior(anio_mes: str) -> str:
+    """El "YYYY-MM" del mes calendario justo anterior."""
+    anio, mes = int(anio_mes[:4]), int(anio_mes[5:7])
+    if mes == 1:
+        return f"{anio - 1:04d}-12"
+    return f"{anio:04d}-{mes - 1:02d}"
+
+
+def ultimos_periodos(anio_mes: str, meses: int) -> list[str]:
+    """Los ``meses`` períodos que terminan en ``anio_mes``, del más viejo al más nuevo."""
+    serie = [anio_mes]
+    for _ in range(meses - 1):
+        serie.append(mes_anterior(serie[-1]))
+    return list(reversed(serie))
+
+
+# ─── Write-through / cierre: el upsert del snapshot ───────────────────────────
+
+def _crudos_a_columnas(crudos: dict) -> dict:
+    """Del dict ``crudos`` de ``plataforma_metricas`` a las columnas del snapshot."""
+    return {
+        "sedes": crudos["sedes"],
+        "espacios_comercializables": crudos["caras"],
+        "ocupadas": crudos["ocupadas"],
+        "contratos_activos": crudos["contratos"],
+        "canon_total": crudos["canon_total"],
+        "proveedores_json": json.dumps(crudos["proveedores"]),
+        # Ordenados para que la fila sea estable entre capturas del mismo mes.
+        "usuarios_json": json.dumps(sorted(crudos["usuarios"])),
+    }
+
+
+def _columnas_a_crudos(fila) -> dict:
+    """Reconstruye el dict ``crudos`` desde una fila de ``snapshot_metricas``.
+
+    Es la inversa exacta de ``_crudos_a_columnas``: lo que sale de acá se puede
+    dar tal cual a ``publicas_desde_crudos`` / ``consolidar_agregado``.
+    """
+    return {
+        "sedes": fila.sedes,
+        "caras": fila.espacios_comercializables,
+        "ocupadas": fila.ocupadas,
+        "contratos": fila.contratos_activos,
+        "canon_total": fila.canon_total,
+        "proveedores": json.loads(fila.proveedores_json or "{}"),
+        "usuarios": json.loads(fila.usuarios_json or "[]"),
+    }
+
+
+def persistir_snapshots(anio_mes: str, capturados: list[tuple[str, dict]]) -> None:
+    """Upsert del snapshot de ``anio_mes`` para cada ``(slug, crudos)`` capturado.
+
+    Reglas de convergencia/congelado:
+
+    · **Un período FUTURO no se snapshotea.** Mirar un mes que todavía no llegó
+      no es historia; guardarlo metería una fila prematura (y vacía) en la serie.
+    · **El mes en curso se ACTUALIZA** en cada captura: converge al valor final
+      a medida que el mes avanza y se firman o vencen contratos.
+    · **Un mes ya cerrado se CONGELA**: se inserta la primera vez y no se vuelve
+      a tocar, aunque alguien vuelva a mirar ese mes más tarde.
+
+    Idempotente por ``UNIQUE(cliente_slug, periodo)``. Escribe SÓLO en el
+    registro; ninguna base de cliente se abre acá.
+    """
+    if anio_mes > periodo_actual():
+        return  # el futuro no es historia
+
+    from app.clientes import sesion_registro
+    from app.models.plataforma import SnapshotMetricas
+
+    actualizar = anio_mes == periodo_actual()
+    ahora = datetime.now(timezone.utc)
+
+    reg = sesion_registro()
+    try:
+        existentes = {
+            f.cliente_slug: f
+            for f in reg.query(SnapshotMetricas).filter(
+                SnapshotMetricas.periodo == anio_mes
+            ).all()
+        }
+        for slug, crudos in capturados:
+            columnas = _crudos_a_columnas(crudos)
+            fila = existentes.get(slug)
+            if fila is None:
+                reg.add(SnapshotMetricas(
+                    cliente_slug=slug, periodo=anio_mes, capturado_en=ahora, **columnas,
+                ))
+            elif actualizar:
+                for k, v in columnas.items():
+                    setattr(fila, k, v)
+                fila.capturado_en = ahora
+            # else: mes cerrado ya capturado → se deja congelado.
+        reg.commit()
+    finally:
+        reg.close()
+
+
+def cerrar_mes_anterior() -> None:
+    """Captura el mes ya cerrado si aún le falta a algún cliente activo.
+
+    Corre desde el ciclo de mantenimiento. Es idempotente y barato en régimen:
+    si todos los clientes activos ya tienen su fila del mes anterior, no recalcula
+    nada. Si falta al menos uno, recalcula ese período —que hace el write-through
+    (insert-only, porque es un mes pasado)— reusando ``calcular``, tolerante a
+    fallos por cliente igual que el resto del mantenimiento.
+    """
+    from app.clientes import listar, sesion_registro
+    from app.models.plataforma import SnapshotMetricas
+    from app.plataforma_metricas import calcular
+
+    cerrado = mes_anterior(periodo_actual())
+
+    activos = {c.slug for c in listar()}
+    if not activos:
+        return
+
+    reg = sesion_registro()
+    try:
+        ya = {
+            f.cliente_slug
+            for f in reg.query(SnapshotMetricas.cliente_slug).filter(
+                SnapshotMetricas.periodo == cerrado
+            ).all()
+        }
+    finally:
+        reg.close()
+
+    if activos.issubset(ya):
+        return  # todos los activos ya tienen el mes cerrado: nada que hacer
+
+    # `calcular` recorre las bases en secuencia, tolerante a fallos por cliente,
+    # y su write-through inserta las filas que falten del mes cerrado.
+    calcular(cerrado)
+
+
+# ─── La serie, para el endpoint ───────────────────────────────────────────────
+
+CONSOLIDADO = "__consolidado__"
+
+
+class ClienteDesconocido(ValueError):
+    """El ``cliente`` pedido no es ``__consolidado__`` ni un slug del registro."""
+
+
+def _meses_saneado(crudo) -> int:
+    """``meses`` acotado a 1..24; el default si no vino nada. Nunca levanta."""
+    if crudo is None:
+        return MESES_DEFAULT
+    try:
+        n = int(crudo)
+    except (TypeError, ValueError):
+        return MESES_DEFAULT
+    return max(1, min(MESES_MAXIMO, n))
+
+
+def _existe_cliente(slug: str) -> bool:
+    from app.clientes import sesion_registro
+    from app.models.models import ClienteRow
+
+    reg = sesion_registro()
+    try:
+        return reg.query(ClienteRow).filter(ClienteRow.slug == slug).first() is not None
+    finally:
+        reg.close()
+
+
+def tendencia(cliente: str, meses_crudo) -> dict:
+    """La serie de los últimos N meses para un cliente o para el consolidado.
+
+    Devuelve SÓLO los meses que tienen dato en el alcance pedido (los huecos —un
+    cliente que aún no existía, un mes sin snapshot— no se rellenan con ceros),
+    en orden cronológico. Cada punto trae los agregados PÚBLICOS de ese mes (K=3
+    y saneo aplicados al leer) y una marca ``parcial`` para el mes en curso, que
+    todavía está convergiendo.
+
+    ``suficiente`` es ``False`` con menos de dos puntos: una tendencia es un
+    cambio en el tiempo, y con un solo mes no hay cambio que mostrar — el
+    frontend pinta un estado vacío honesto en vez de una línea de un punto.
+    """
+    from app.clientes import sesion_registro
+    from app.models.plataforma import SnapshotMetricas
+
+    alcance = (cliente or CONSOLIDADO).strip()
+    if alcance != CONSOLIDADO and not _existe_cliente(alcance):
+        raise ClienteDesconocido(alcance)
+
+    meses = _meses_saneado(meses_crudo)
+    actual = periodo_actual()
+    periodos = ultimos_periodos(actual, meses)
+    ventana = set(periodos)
+
+    reg = sesion_registro()
+    try:
+        q = reg.query(SnapshotMetricas).filter(SnapshotMetricas.periodo.in_(periodos))
+        if alcance != CONSOLIDADO:
+            q = q.filter(SnapshotMetricas.cliente_slug == alcance)
+        filas = q.all()
+    finally:
+        reg.close()
+
+    # Agrupar por período los crudos de cada fila (una por cliente).
+    por_periodo: dict[str, list[dict]] = {}
+    for fila in filas:
+        if fila.periodo not in ventana:
+            continue
+        por_periodo.setdefault(fila.periodo, []).append(_columnas_a_crudos(fila))
+
+    serie = []
+    for periodo in periodos:
+        crudos_mes = por_periodo.get(periodo)
+        if not crudos_mes:
+            continue  # hueco: sin snapshot en este alcance → no se inventa
+        if alcance == CONSOLIDADO:
+            publicas = consolidar_agregado(crudos_mes)
+        else:
+            publicas = publicas_desde_crudos(crudos_mes[0])
+        serie.append({
+            "periodo": periodo,
+            "parcial": periodo == actual,
+            "metricas": publicas,
+        })
+
+    return {
+        "cliente": alcance,
+        "meses_pedidos": meses,
+        "generado_en": datetime.now(timezone.utc)
+            .isoformat(timespec="seconds").replace("+00:00", "Z"),
+        "suficiente": len(serie) >= 2,
+        "serie": serie,
+    }
+
+
+# Re-exports usados por el router (para no reimportar de dos módulos).
+__all__ = [
+    "tendencia",
+    "persistir_snapshots",
+    "cerrar_mes_anterior",
+    "ultimos_periodos",
+    "mes_anterior",
+    "ClienteDesconocido",
+    "normalizar_periodo",
+    "rango_del_periodo",
+    "CONSOLIDADO",
+    "MESES_DEFAULT",
+    "MESES_MAXIMO",
+]
