+const mesCorto = (periodo: string): string => {
+  const [y, m] = periodo.split("-").map(Number);
+  if (!y || !m) return periodo;
+  const d = new Date(Date.UTC(y, m - 1, 1));
+  const mes = d.toLocaleDateString("es-CO", { month: "short", timeZone: "UTC" }).replace(".", "");
