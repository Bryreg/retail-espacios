diff --git a/backend/tests/test_plataforma_tendencia.py b/backend/tests/test_plataforma_tendencia.py
new file mode 100644
index 0000000..44c4a45
--- /dev/null
+++ b/backend/tests/test_plataforma_tendencia.py
@@ -0,0 +1,416 @@
+"""Fase 5: serie de tiempo de las métricas (histórico + tendencia para asesoría).
+
+Se prueba la cadena entera de la fase, contra datos sembrados a mano:
+
+* **Snapshot CRUDO + lectura pública**: la tabla nueva del registro guarda los
+  sumandos crudos; la supresión K=3 y el saneo se aplican AL LEER, reusando la
+  lógica de ``plataforma_metricas`` — un solo lugar para la privacidad.
+* **Poblado híbrido**: write-through al abrir métricas de un período, y cierre
+  automático del mes ya cerrado desde el mantenimiento, sin abrir la consola.
+* **El endpoint** ``GET /api/plataforma/tendencia``: consolidado ponderado y por
+  cliente, mes en curso parcial, estado insuficiente con < 2 meses, operator-only
+  y con bitácora.
+
+Reusa el andamiaje de ``test_plataforma_metricas`` (identidades falsas, alta
+self-service, sembrado en la base del cliente, operador sin membresías). El
+"mes en curso" es ``periodo_actual()`` en UTC; los datos se siembran en los tres
+meses que terminan hoy para que la serie tenga un pasado congelado y un presente
+parcial de verdad.
+"""
+from datetime import date
+
+from tests.test_plataforma_metricas import (
+    Identidades,
+    _cab,
+    _fundar,
+    _operador_sin_membresias,
+    _sembrar,
+)
+
+from app.plataforma_metricas import periodo_actual
+from app.plataforma_tendencia import mes_anterior, ultimos_periodos
+
+
+# ─── Los tres meses de la ventana ────────────────────────────────────────────
+# Hoy es el mes en curso (parcial); los dos anteriores son pasado (congelado).
+
+ACTUAL = periodo_actual()
+MES_1 = mes_anterior(mes_anterior(ACTUAL))   # el más viejo de los tres
+MES_2 = mes_anterior(ACTUAL)                 # el mes ya cerrado
+MES_3 = ACTUAL                               # el mes en curso, parcial
+
+
+def _rango(anio_mes: str) -> tuple[str, str]:
+    """(desde, hasta) ISO del mes, para acotar un contrato a ese mes exacto."""
+    import calendar
+
+    anio, mes = int(anio_mes[:4]), int(anio_mes[5:7])
+    ultimo = calendar.monthrange(anio, mes)[1]
+    return f"{anio:04d}-{mes:02d}-01", f"{anio:04d}-{mes:02d}-{ultimo:02d}"
+
+
+def _fixtures(sede: str, n: int) -> list:
+    return [{"code": f"E-{i:02d}", "type": "punta", "sede": sede} for i in range(1, n + 1)]
+
+
+def _leases_del_mes(sede: str, anio_mes: str, cuantos: int, canon=100_000.0, prov="Prov"):
+    """`cuantos` contratos activos SÓLO en `anio_mes`, sobre E-01..E-cuantos."""
+    desde, hasta = _rango(anio_mes)
+    return [
+        (f"{sede}-E-{i:02d}", f"{prov}{i}", desde, hasta, canon, True)
+        for i in range(1, cuantos + 1)
+    ]
+
+
+def _tendencia(client, cab, cliente="__consolidado__", meses=None):
+    q = f"?cliente={cliente}"
+    if meses is not None:
+        q += f"&meses={meses}"
+    return client.get(f"/api/plataforma/tendencia{q}", headers=cab)
+
+
+def _pedir_metricas(client, cab, periodo):
+    r = client.get(f"/api/plataforma/metricas?periodo={periodo}", headers=cab)
+    assert r.status_code == 200, r.text
+    return r.json()
+
+
+def _punto(cuerpo, periodo):
+    return next((p for p in cuerpo["serie"] if p["periodo"] == periodo), None)
+
+
+# ─── Escenario: acme con 3/4/5 contratos en los tres meses ───────────────────
+
+def _acme_tres_meses(client, monkeypatch):
+    """Funda acme, siembra 3/4/5 contratos en MES_1/2/3 y captura los tres por
+    write-through (abrir métricas de cada período). Devuelve la cabecera del
+    operador de la consola."""
+    from app.plataforma_metricas import limpiar_cache_metricas
+
+    ids = Identidades(client)
+    _fundar(ids, "uid-acme", "duena@acme.co", "acme", "Acme")
+    contratos = (
+        _leases_del_mes("NAVE", MES_1, 3)
+        + _leases_del_mes("NAVE", MES_2, 4)
+        + _leases_del_mes("NAVE", MES_3, 5)
+    )
+    _sembrar("acme", {"NAVE": _fixtures("NAVE", 5)}, contratos)
+    consola = _operador_sin_membresias(ids, monkeypatch)
+    cab = _cab(consola["token"])
+    limpiar_cache_metricas()
+
+    # Write-through: abrir métricas de cada período deja su snapshot.
+    for p in (MES_1, MES_2, MES_3):
+        _pedir_metricas(client, cab, p)
+    return cab
+
+
+# ════════════════════════════════════════════════════════════════════════════
+# La serie por cliente, contra datos sembrados
+# ════════════════════════════════════════════════════════════════════════════
+
+def test_serie_de_un_cliente_devuelve_los_tres_meses_en_orden(client, monkeypatch):
+    cab = _acme_tres_meses(client, monkeypatch)
+    r = _tendencia(client, cab, cliente="acme")
+    assert r.status_code == 200, r.text
+    cuerpo = r.json()
+
+    assert cuerpo["cliente"] == "acme"
+    assert cuerpo["suficiente"] is True
+    # Cronológico y sólo los meses con dato (los huecos de la ventana no se rellenan).
+    assert [p["periodo"] for p in cuerpo["serie"]] == [MES_1, MES_2, MES_3]
+
+    m1, m2, m3 = (p["metricas"] for p in cuerpo["serie"])
+    assert (m1["ocupacion_pct"], m1["ingreso_contratado_mes"]) == (60.0, 300_000.0)
+    assert (m2["ocupacion_pct"], m2["ingreso_contratado_mes"]) == (80.0, 400_000.0)
+    assert (m3["ocupacion_pct"], m3["ingreso_contratado_mes"]) == (100.0, 500_000.0)
+    assert [p["metricas"]["espacios_comercializables"] for p in cuerpo["serie"]] == [5, 5, 5]
+
+
+def test_el_mes_en_curso_va_marcado_parcial_y_los_pasados_no(client, monkeypatch):
+    cab = _acme_tres_meses(client, monkeypatch)
+    cuerpo = _tendencia(client, cab, cliente="acme").json()
+
+    parciales = {p["periodo"]: p["parcial"] for p in cuerpo["serie"]}
+    assert parciales[MES_1] is False
+    assert parciales[MES_2] is False
+    assert parciales[MES_3] is True  # el mes en curso
+
+
+def test_con_un_solo_mes_la_serie_es_insuficiente(client, monkeypatch):
+    """Una tendencia es un cambio en el tiempo: con un mes no hay tendencia."""
+    from app.plataforma_metricas import limpiar_cache_metricas
+
+    ids = Identidades(client)
+    _fundar(ids, "uid-solo", "duena@solo.co", "solo", "Solo")
+    _sembrar("solo", {"S": _fixtures("S", 3)}, _leases_del_mes("S", MES_3, 3))
+    consola = _operador_sin_membresias(ids, monkeypatch)
+    cab = _cab(consola["token"])
+    limpiar_cache_metricas()
+    _pedir_metricas(client, cab, MES_3)  # sólo el mes en curso
+
+    cuerpo = _tendencia(client, cab, cliente="solo").json()
+    assert [p["periodo"] for p in cuerpo["serie"]] == [MES_3]
+    assert cuerpo["suficiente"] is False  # el frontend pinta estado vacío honesto
+
+
+# ════════════════════════════════════════════════════════════════════════════
+# Consolidado ponderado
+# ════════════════════════════════════════════════════════════════════════════
+
+def test_consolidado_pondera_y_suma_los_clientes_del_mes(client, monkeypatch):
+    """Dos clientes en el mismo mes → el consolidado suma ingreso y pondera ocupación."""
+    from app.plataforma_metricas import limpiar_cache_metricas
+
+    ids = Identidades(client)
+    _fundar(ids, "uid-a", "duena@a.co", "aa", "A")
+    _fundar(ids, "uid-b", "duena@b.co", "bb", "B")
+    # A: 3 caras, 3 ocupadas en MES_2 y MES_3.  B: 4 caras, 2 ocupadas.
+    _sembrar("aa", {"A": _fixtures("A", 3)},
+             _leases_del_mes("A", MES_2, 3) + _leases_del_mes("A", MES_3, 3))
+    _sembrar("bb", {"B": _fixtures("B", 4)},
+             _leases_del_mes("B", MES_2, 2, canon=50_000.0)
+             + _leases_del_mes("B", MES_3, 4, canon=50_000.0))
+    consola = _operador_sin_membresias(ids, monkeypatch)
+    cab = _cab(consola["token"])
+    limpiar_cache_metricas()
+    for p in (MES_2, MES_3):
+        _pedir_metricas(client, cab, p)
+
+    cuerpo = _tendencia(client, cab, cliente="__consolidado__").json()
+    assert cuerpo["cliente"] == "__consolidado__"
+    p3 = _punto(cuerpo, MES_3)["metricas"]
+
+    # Ingreso consolidado = A (3·100k) + B (4·50k) = 300k + 200k = 500k.
+    assert p3["ingreso_contratado_mes"] == 500_000.0
+    # Ocupación ponderada = Σ ocupadas / Σ caras = (3+4)/(3+4) = 100%.
+    assert p3["ocupacion_pct"] == 100.0
+    # Canon promedio PONDERADO = Σ canon / Σ contratos = 500k / 7, no el promedio
+    # de promedios (100k y 50k → 75k).
+    assert p3["canon_promedio_mensual"] == round(500_000.0 / 7, 2)
+    assert p3["canon_promedio_mensual"] != 75_000.0
